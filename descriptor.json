        "agent/__init__.py",
        "agent/asessor_agent.py",
        "agent/config.py",
        "agent/prompts.py",
        "agent/pydantic_output.py",
        "agent/score_results.py",
        "agent/sds_chat_model.py",
        "retriever/__init__.py",
        "retriever/doc_loaders.py",
        "retriever/retriever.py",
        "laim_monitoring/__init__.py",
        "laim_monitoring/core.py",
        "measurement.py"
      ],
      "libraryDependencies": [
        "requirements.txt"
      ],
      "functionName": "main",
      "functionParameters": [],
      "output": {
        "type": "json",
